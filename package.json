{
  "name": "scrappy",
  "version": "0.1.0",
  "description": "Mac quick capture notes app",
  "author": "cdnicoll (https://github.com/cdnicoll)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cdnicoll/scrappy.git"
  },
  "homepage": "https://github.com/cdnicoll/scrappy",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.0",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  },
  "productName": "Scrappy",
  "build": {
    "appId": "com.cdnicoll.scrappy",
    "productName": "Scrappy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/*.png",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    }
  }
}
